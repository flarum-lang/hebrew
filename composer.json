{
	"name": "flarum-lang/hebrew",
	"description": "Hebrew Language Pack for Flarum",
	"type": "flarum-extension",
	"keywords": [
		"flarum-locale"
	],
	"homepage": "https://github.com/flarum-lang/hebrew",
	"license": "MIT",
	"authors": [
		{
			"name": "icecore2",
			"homepage": "https://github.com/icecore2",
			"role": "Maintainer"
		}
	],
	"support": {
		"issues": "https://github.com/flarum-lang/hebrew/issues",
		"forum": "https://discuss.flarum.org/d/6473",
		"source": "https://github.com/flarum-lang/hebrew"
	},
	"require": {
		"flarum/core": "^2.0"
	},
	"extra": {
		"flarum-extension": {
			"title": "Hebrew",
			"category": "language",
			"icon": {
				"image": "icon.svg",
				"backgroundColor": "#00247d",
				"backgroundSize": "cover",
				"backgroundPosition": "center"
			}
		},
		"flarum-locale": {
			"code": "he",
			"title": "עברית",
			"direction": "rtl"
		}
	}
}
